# GaoOS A/B boot configuration. Customize /storage/.config/gaoos-ab.conf.
# Remote updates require an HTTPS control-plane origin and provisioned device
# credentials and public signing keys. An empty origin leaves local recovery enabled.
UPDATE_API_URL=""
UPDATE_TOKEN_FILE="/storage/.config/gaoos-ota/device-token"
UPDATE_TRUST_FILE="/storage/.config/gaoos-ota/trusted-keys.json"
