#
# gaoos-update — A/B slot update manager for GaoOS
#
# Commands:
#   status    — Show slot status
#   check     — Check for available updates
#   download  — Download update image
#   apply     — Write image to inactive slot
#   canary    — Download + verify + apply (no reboot)
#   rollback  — Switch active slot to the other slot
#   confirm   — Mark current slot as good

set -euo pipefail

# Paths
AB_STATE="/flash/ab_state.env"
AB_LOCK="/run/gaoos-ab.lock"
OTA_CLIENT="/usr/lib/gaoos/gaoos-ota-client.sh"
DEVICE_FILE="/etc/gaoos-device"
VERSION_FILE="/etc/gaoos-version"
STAGING_DIR="/storage/.update"
PROGRESS_FILE="/tmp/gaoos-update-progress"

# ──────────────────────────────────────────────────────────────
# Helpers
# ──────────────────────────────────────────────────────────────

log() { echo "[gaoos-update] $*" >&2; }
err() { echo "[gaoos-update] ERROR: $*" >&2; }
die() { err "$@"; exit 1; }

progress() {
  local pct="$1" msg="$2"
  echo "${pct} ${msg}" > "${PROGRESS_FILE}" 2>/dev/null || true
  echo "[${pct}%] ${msg}" >&2
}

get_device() {
  if [ -f "${DEVICE_FILE}" ]; then
    cat "${DEVICE_FILE}"
  else
    # Fallback: try to get from os-release
    [ -f /etc/os-release ] && . /etc/os-release
    echo "${HW_DEVICE:-unknown}"
  fi
}

get_version() {
  if [ -f "${VERSION_FILE}" ]; then
    cat "${VERSION_FILE}"
  else
    [ -f /etc/os-release ] && . /etc/os-release
    echo "${VERSION:-unknown}"
  fi
}

get_running_slot() {
  local arg slot="" cmdline
  read -r -a cmdline < /proc/cmdline
  for arg in "${cmdline[@]}"; do
    case "${arg}" in
      gaoos.slot=*)
        [ -z "${slot}" ] || return 1
        slot="${arg#*=}"
        case "${slot}" in a|b) ;; *) return 1 ;; esac
        ;;
    esac
  done
  [ -n "${slot}" ] || return 1
  echo "${slot}"
}

get_inactive_slot() {
  local running="$1"
  if [ "${running}" = "a" ]; then
    echo "b"
  else
    echo "a"
  fi
}

get_boot_dev() {
  # Linux MMC numbering can differ from U-Boot's gaoos.dev hint. Match init:
  # select slots on the disk whose boot partition is actually mounted at /flash.
  local dev
  dev=$(awk '$2 == "/flash" {count++; if ($3 == "vfat") dev=$1}
             END {if (count != 1 || !dev) exit 1; print dev}' /proc/mounts) ||
    die "Cannot identify A/B boot disk: expected one FAT mount at /flash"
  dev=$(readlink -f "${dev}") || die "Cannot resolve /flash boot device"
  if [[ "${dev}" =~ ^/dev/((mmcblk|loop)[0-9]+|nvme[0-9]+n[0-9]+)p1$ ]]; then
    dev="${dev%p1}"
  elif [[ "${dev}" =~ ^/dev/sd[a-z]+1$ ]]; then
    dev="${dev%1}"
  else
    die "Cannot identify A/B boot disk from ${dev}"
  fi
  echo "${dev#/dev/}"
}

get_slot_partition() {
  # Map slot letter to partition device path
  local slot="$1" dev="$2"
  local sep=""
  case "${dev}" in
    mmcblk*|loop*|nvme*) sep="p" ;;
  esac
  case "${slot}" in
    a) echo "/dev/${dev}${sep}2" ;;
    b) echo "/dev/${dev}${sep}3" ;;
    *) die "Invalid slot: ${slot}" ;;
  esac
}

# Match kernel device numbers to handle udev aliases and bind mounts.
block_identity() {
  local dev="$1" id kernel_id
  [ -b "${dev}" ] || return 1
  id=$(stat -Lc '%t:%T' "${dev}") || return 1
  [[ "${id}" =~ ^([[:xdigit:]]+):([[:xdigit:]]+)$ ]] || return 1
  id=$(printf '%d:%d' "0x${BASH_REMATCH[1]}" "0x${BASH_REMATCH[2]}") || return 1
  read -r kernel_id < "/sys/class/block/${dev##*/}/dev" || return 1
  [ "${id}" = "${kernel_id}" ] || return 1
  printf '%s\n' "${id}"
}

slot_partitions() {
  local running="$1" inactive="$2" dev source_part target_part source_id target_id
  dev=$(get_boot_dev) || return 1
  source_part=$(get_slot_partition "${running}" "${dev}") || return 1
  target_part=$(get_slot_partition "${inactive}" "${dev}") || return 1
  source_id=$(block_identity "${source_part}") || die "Running partition ${source_part} is unavailable"
  target_id=$(block_identity "${target_part}") || die "Inactive partition ${target_part} is unavailable"
  [ "${source_id}" != "${target_id}" ] || die "Slot devices refer to the same partition"
  awk -v source="${source_id}" -v target="${target_id}" '
    $5 == "/" {
      roots++
      if ($3 == source && ("," $6 ",") ~ /,ro,/ && / - squashfs /) correct_root=1
    }
    $3 == target {target_mounted=1}
    END {exit !(roots == 1 && correct_root && !target_mounted)}
  ' /proc/self/mountinfo || die "Expected the running SquashFS on ${source_part} and an unmounted inactive partition"
  printf '%s %s\n' "${source_part}" "${target_part}"
}

lock_ab_state() {
  exec 9>>"${AB_LOCK}" || die "Cannot open A/B update lock"
  flock -n 9 || die "Another A/B state operation is in progress"
}

# ──────────────────────────────────────────────────────────────
# A/B State Management
# ──────────────────────────────────────────────────────────────

read_ab_state() {
  active_slot="a"
  status_a=""
  status_b=""
  retry_a="0"
  retry_b="0"
  max_retries="3"
  # Boot metadata is data, never a shell program. Refuse malformed values rather
  # than overwriting a failed slot with a fabricated successful state.
  [ -f "${AB_STATE}" ] || return 1
  local key value seen=" "
  while IFS='=' read -r key value; do
    case "${seen}" in *" ${key} "*) return 1 ;; esac
    seen+="${key} "
    case "${key}" in
      active_slot) case "${value}" in a|b) active_slot="${value}" ;; *) return 1 ;; esac ;;
      status_a|status_b)
        case "${value}" in good|pending|bad|"") printf -v "${key}" '%s' "${value}" ;; *) return 1 ;; esac ;;
      retry_a|retry_b) case "${value}" in 0|1|2|3) printf -v "${key}" '%s' "${value}" ;; *) return 1 ;; esac ;;
      max_retries) [ "${value}" = 3 ] || return 1 ;;
      *) return 1 ;;
    esac
  done < "${AB_STATE}"
  # U-Boot omits undefined/empty status keys during text export. The four core
  # fields must still exist; omitted statuses mean empty, never confirmed good.
  for key in active_slot retry_a retry_b max_retries; do
    case "${seen}" in *" ${key} "*) ;; *) return 1 ;; esac
  done
}

write_ab_state() {
  # Mount boot partition RW if needed
  local was_ro=0
  if awk '$2 == "/flash" && ("," $4 ",") ~ /,ro,/ {ro=1} END {exit !ro}' /proc/mounts; then
    mount -o remount,rw /flash 2>/dev/null || return 1
    was_ro=1
  fi

  local state_tmp result=0
  state_tmp=$(mktemp "${AB_STATE}.XXXXXX") || result=1
  if [ "${result}" = "0" ]; then
    if ! cat > "${state_tmp}" <<EOF
active_slot=${active_slot}
status_a=${status_a}
status_b=${status_b}
retry_a=${retry_a}
retry_b=${retry_b}
max_retries=${max_retries}
EOF
    then
      result=1
    fi
    # Flush the replacement before renaming on the same boot filesystem.
    # A failed write/flush/rename leaves the previous boot metadata intact.
    if [ "${result}" != "0" ] || ! sync || ! mv -f "${state_tmp}" "${AB_STATE}"; then
      result=1
    elif ! sync; then
      result=1
    fi
    rm -f "${state_tmp}"
  fi

  # Restore RO if it was RO
  if [ "${was_ro}" = "1" ]; then
    mount -o remount,ro /flash 2>/dev/null || true
  fi
  return "${result}"
}

verify_checksum() {
  local image="$1" checksum_file="$2" expected actual
  expected=$(awk 'NR == 1 {print $1}' "${checksum_file}" | tr '[:upper:]' '[:lower:]') ||
    die "Cannot read checksum file: ${checksum_file}"
  [[ "${expected}" =~ ^[[:xdigit:]]{64}$ ]] || die "Invalid checksum file: ${checksum_file}"
  actual=$(sha256sum "${image}" | awk '{print $1}') || die "Cannot hash image: ${image}"
  [ "${actual}" = "${expected}" ] || die "Checksum mismatch: ${image}"
}

slot_status() {
  local field="status_$1"
  printf '%s\n' "${!field}"
}

load_ota_client() {
  local module="${OTA_CLIENT}"
  [ -f "${module}" ] || module="$(dirname "$0")/gaoos-ota-client.sh"
  [ -f "${module}" ] || return 1
  source "${module}" || die "Cannot load the OTA client"
}

# ──────────────────────────────────────────────────────────────
# Commands
# ──────────────────────────────────────────────────────────────

cmd_status() {
  read_ab_state || die "Invalid A/B state"
  local running
  running=$(get_running_slot) || die "Cannot identify running slot"
  local inactive
  inactive=$(get_inactive_slot "${running}")
  local device
  device=$(get_device)
  local version
  version=$(get_version)

  echo "GaoOS A/B Boot Status"
  echo "====================="
  echo "Device:       ${device}"
  echo "Version:      ${version}"
  echo "Running slot: ${running}"
  echo "Active slot:  ${active_slot}"
  echo ""
  echo "Slot A:"
  echo "  Status:  ${status_a:-empty}"
  echo "  Retries: ${retry_a}"
  echo ""
  echo "Slot B:"
  echo "  Status:  ${status_b:-empty}"
  echo "  Retries: ${retry_b}"
  echo ""

  if [ "${active_slot}" = "${inactive}" ] && [ "$(slot_status "${inactive}")" = pending ]; then
    echo "Staged update: YES (slot ${inactive})"
  else
    echo "Staged update: none"
  fi
}

cmd_apply() (
  local image="$1" expected_sha256="${2:-}" expected_bytes="${3:-}"
  local running inactive partitions source_part target_part running_status
  local image_size target_capacity src_hash written_hash format used_bytes
  local target_status target_retry

  [ -n "${image}" ] || die "Usage: gaoos-update apply <image>"
  [[ "${image}" = /* ]] || image="./${image}"
  [ -f "${image}" ] || die "Image not found: ${image}"
  lock_ab_state
  read_ab_state || die "Invalid A/B state"
  running=$(get_running_slot) || die "Cannot identify running slot"
  inactive=$(get_inactive_slot "${running}")
  partitions=$(slot_partitions "${running}" "${inactive}") || exit 1
  read -r source_part target_part <<< "${partitions}"
  running_status=$(slot_status "${running}")
  [ "${active_slot}" = "${running}" ] && [ "${running_status}" = good ] ||
    die "Finish booting the selected slot and confirm it before replacing the inactive slot"

  if [ -n "${expected_sha256}${expected_bytes}" ]; then
    [[ "${expected_sha256}" =~ ^[0-9a-f]{64}$ && "${expected_bytes}" =~ ^[1-9][0-9]{0,15}$ ]] ||
      die "Invalid signed artifact integrity fields"
    [ "$(stat -c %s "${image}")" = "${expected_bytes}" ] || die "Signed artifact size mismatch"
  elif [ -f "${image}.sha256" ]; then
    log "Verifying source checksum..."
    verify_checksum "${image}" "${image}.sha256"
  fi

  # Check if this is a delta patch (M7) — bspatch files start with "BSDIFF40"
  if [ "$(head -c 8 "${image}" | tr -d '\000')" = "BSDIFF40" ]; then
    # Delta update path (M7)
    [ -z "${expected_sha256}" ] || die "OTA manifests require a full SquashFS image"
    command -v bspatch >/dev/null 2>&1 || die "bspatch not found — cannot apply delta update. Use full image instead."
    [ -f "${image}.target.sha256" ] || die "Delta update requires a target image checksum"

    # bspatch needs a regular old-image file. A block device has no file size,
    # and its partition padding is not part of the original SquashFS payload.
    local source_bytes source_size source_capacity source_format delta_dir
    [ "$(head -c 4 "${source_part}")" = "hsqs" ] || die "Invalid source SquashFS magic"
    source_format=$(od -An -tu2 -j28 -N4 "${source_part}" | xargs) || die "Cannot read source SquashFS version"
    [ "${source_format}" = "4 0" ] || die "Unsupported source SquashFS version"
    source_bytes=$(od -An -tu8 -j40 -N8 "${source_part}" | tr -d '[:space:]') || die "Cannot read source SquashFS size"
    source_capacity=$(blockdev --getsize64 "${source_part}") || die "Cannot read running slot capacity"
    [[ "${source_bytes}" =~ ^[1-9][0-9]{0,15}$ ]] || die "Invalid source SquashFS size"
    [ "${source_bytes}" -ge 96 ] && [ "${source_bytes}" -le "${source_capacity}" ] || die "Source SquashFS exceeds slot bounds"
    source_size=$(( (source_bytes + 4095) / 4096 * 4096 ))
    [ "${source_size}" -le "${source_capacity}" ] || die "Source SquashFS padding exceeds slot bounds"

    mkdir -p "${STAGING_DIR}" || die "Cannot create staging directory"
    delta_dir=$(mktemp -d "${STAGING_DIR}/.delta-XXXXXX") || die "Cannot create delta workspace"
    trap 'rm -rf "${delta_dir}"' EXIT
    head -c "${source_size}" "${source_part}" > "${delta_dir}/source.squashfs" || die "Cannot read delta base"
    [ "$(stat -c %s "${delta_dir}/source.squashfs")" = "${source_size}" ] || die "Incomplete source SquashFS read"

    log "Reconstructing delta image from slot ${running}..."
    progress 0 "Reconstructing delta image..."
    bspatch "${delta_dir}/source.squashfs" "${delta_dir}/system.squashfs" "${image}" || die "bspatch failed"
    verify_checksum "${delta_dir}/system.squashfs" "${image}.target.sha256"
    image="${delta_dir}/system.squashfs"
    progress 100 "Delta image verified"
  fi

  image_size=$(stat -c %s "${image}") || die "Cannot read image size"
  target_capacity=$(blockdev --getsize64 "${target_part}") || die "Cannot read inactive slot capacity"
  [ "${image_size}" -ge 96 ] && [ "${image_size}" -le "${target_capacity}" ] || die "Image exceeds slot capacity or is too small"
  [ "$(head -c 4 "${image}" | tr -d '\000')" = "hsqs" ] || die "Invalid SquashFS magic"
  format=$(od -An -tu2 -j28 -N4 "${image}" | xargs) || die "Cannot read SquashFS version"
  [ "${format}" = "4 0" ] || die "Unsupported SquashFS version"
  used_bytes=$(od -An -tu8 -j40 -N8 "${image}" | tr -d '[:space:]') || die "Cannot read SquashFS size"
  [[ "${used_bytes}" =~ ^[1-9][0-9]{0,15}$ ]] && [ "${used_bytes}" -ge 96 ] &&
    [ "${used_bytes}" -le "${image_size}" ] || die "SquashFS data exceeds image bounds"
  if command -v unsquashfs >/dev/null 2>&1; then
    log "Validating SquashFS image..."
    unsquashfs -s "${image}" >/dev/null 2>&1 || die "Invalid SquashFS image: ${image}"
  fi
  src_hash=$(sha256sum "${image}" | awk '{print $1}') || die "Cannot hash image"
  [ -z "${expected_sha256}" ] || [ "${src_hash}" = "${expected_sha256}" ] || die "Signed artifact checksum mismatch"

  # From this point a failed or interrupted write can destroy the previous
  # contents of the inactive slot. Retire any bootable copy before writing.
  target_status="status_${inactive}"
  target_retry="retry_${inactive}"
  if [ "${!target_status}" = good ] || [ "${!target_status}" = pending ]; then
    printf -v "${target_status}" '%s' bad
    printf -v "${target_retry}" '%s' 0
    write_ab_state || die "Cannot retire the previous inactive slot before writing"
  fi

  log "Writing image to slot ${inactive} (${target_part})..."
  log "Active/running slot ${running} will NOT be modified."
  progress 0 "Writing to slot ${inactive}..."
  dd if="${image}" of="${target_part}" bs=4M conv=fsync 2>&1 | while IFS= read -r line; do
    local bytes
    bytes=$(echo "${line}" | sed -n 's/^\([0-9]*\) bytes.*/\1/p')
    if [ -n "${bytes}" ]; then
      local pct=$(( bytes * 100 / image_size ))
      progress "${pct}" "Writing to slot ${inactive}..."
    fi
  done || die "Write to slot ${inactive} failed"
  sync || die "Cannot flush slot ${inactive}"
  progress 100 "Write complete"

  # Verify written data
  log "Verifying written data..."
  progress 0 "Verifying write..."
  written_hash=$(head -c "${image_size}" "${target_part}" | sha256sum | awk '{print $1}') ||
    die "Cannot read back slot ${inactive}"

  if [ "${src_hash}" != "${written_hash}" ]; then
    die "Write verification failed! Slot ${inactive} may be corrupt but running slot is safe."
  fi
  log "Write verification passed"
  progress 100 "Verification complete"

  # Update A/B state
  printf -v "${target_status}" '%s' pending
  printf -v "${target_retry}" '%s' 0
  active_slot="${inactive}"
  write_ab_state || die "Cannot select verified slot ${inactive}"

  log "Slot ${inactive} marked as pending. Active slot set to ${inactive}."
  log "Reboot to boot into the new system. It will auto-confirm after health checks pass."
  log "NOTE: Reboot is NOT automatic. Run 'reboot' when ready."
)

cmd_rollback() (
  lock_ab_state
  read_ab_state || die "Invalid A/B state"
  local running
  running=$(get_running_slot) || die "Cannot identify running slot"
  local other
  other=$(get_inactive_slot "${running}")
  slot_partitions "${running}" "${other}" >/dev/null || exit 1
  [ "$(slot_status "${other}")" = good ] || die "Cannot roll back: slot ${other} is not a confirmed good boot"

  active_slot="${other}"
  write_ab_state || die "Cannot select rollback slot ${other}"

  log "Active slot switched to ${other}."
  log "Reboot to complete rollback. Run 'reboot' when ready."
)

cmd_reboot_ready() (
  lock_ab_state
  read_ab_state || die "Invalid A/B state"
  local running inactive retry
  running=$(get_running_slot) || die "Cannot identify running slot"
  inactive=$(get_inactive_slot "${running}")
  slot_partitions "${running}" "${inactive}" >/dev/null || exit 1
  retry="retry_${inactive}"
  [ "${active_slot}" = "${inactive}" ] && [ "$(slot_status "${inactive}")" = pending ] &&
    [ "${!retry}" -lt "${max_retries}" ] ||
    die "No staged update. Run 'gaoos-update canary' first."
  printf '%s\n' "${inactive}"
)

cmd_confirm() {
  # Manual confirmation must satisfy exactly the same health gate as boot-time
  # confirmation; it cannot turn a damaged or wrong root filesystem good.
  exec /usr/bin/gaoos-boot-confirm
}

# ──────────────────────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────────────────────

usage() {
  echo "Usage: gaoos-update <command> [args]"
  echo ""
  echo "Commands:"
  echo "  status              Show A/B slot status"
  echo "  check               Check for available updates"
  echo "  download [url]      Download update image"
  echo "  apply <image>       Write image to inactive slot"
  echo "  canary              Download, verify, and apply (no reboot)"
  echo "  rollback            Switch to other slot"
  echo "  confirm             Mark running slot as good"
  echo ""
  echo "The active slot is NEVER modified. Updates always write to the inactive slot."
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  status)   cmd_status ;;
  check|download|canary)
    load_ota_client || die "OTA client is unavailable"
    "cmd_ota_${cmd}" "$@"
    ;;
  apply)
    if load_ota_client; then
      cmd_ota_apply "${1:-}"
    else
      cmd_apply "${1:-}"
    fi
    ;;
  rollback) cmd_rollback ;;
  confirm)  cmd_confirm ;;
  reboot-ready) cmd_reboot_ready ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    err "Unknown command: ${cmd}"
    usage
    exit 1
    ;;
esac
