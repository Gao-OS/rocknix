# updatecheck — ES integration wrapper for gaoos-update check
# Replaces upstream's updatecheck script.
# Called by rocknix-config canupdate command.

case "${1}" in
  canupdate)
    result=$(gaoos-update check 2>/dev/null)
    if [ -n "${result}" ] && [ "${result}" != "no" ]; then
      echo "${result}"
      exit 0
    else
      echo "no"
      exit 0
    fi
    ;;
  *)
    gaoos-update check
    ;;
esac
