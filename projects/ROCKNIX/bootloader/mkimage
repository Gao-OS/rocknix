if [ "${GAOOS_AB_BOOT}" = "yes" ]; then
  xmlstarlet val -e "${PROJECT_DIR}/${PROJECT}/config.xml" >"${SAVE_ERROR}" 2>&1 || show_error
  # A valid device can have no subdevices. Its XMLStarlet query returns 1,
  # while config/functions uses the final tr status for this optional result.
  set +o pipefail
fi
. config/functions
if [ "${GAOOS_AB_BOOT}" = "yes" ]; then
  set -o pipefail
fi

mkimage_uboot() {
  local uboot_conv="sync,noerror,notrunc"
  if [ "${GAOOS_AB_BOOT}" = "yes" ]; then
    uboot_conv="fsync,notrunc"
  fi
  if [ "${GAOOS_AB_BOOT}" = "yes" ] && [ "${DEVICE}" = "RK3566" ]; then
    # Never silently fall back to a binary for another RK3566 board variant.
    if [ ! -s "${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_uboot.bin" ]; then
      echo "ERROR: missing or empty ${SUBDEVICE}_uboot.bin" >&2
      show_error
    fi
    local uboot_size
    uboot_size=$(stat -c %s "${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_uboot.bin") || show_error
    if [ "${uboot_size}" -gt "$((SYSTEM_PART_START * 512 - 32768))" ]; then
      echo "ERROR: U-Boot binary overlaps the boot partition" >&2
      show_error
    fi
  fi
  if [ -f "${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_uboot.bin" ]; then
    # RK3566-Generic and RK3566-Powkiddy_x55
    echo "image: writing ${SUBDEVICE}_uboot.bin to $(basename "${DISK}")..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_uboot.bin" of="${DISK}" bs=512 seek=64 conv="${uboot_conv}" >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/uboot.bin" ]; then
    echo "image: writing uboot.bin to $(basename "${DISK}")..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/uboot.bin" of="${DISK}" bs=512 seek=64 conv="${uboot_conv}" >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/u-boot.bin" ]; then
    # S922X
    echo "image: writing u-boot.bin to $(basename "${DISK}")..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/u-boot.bin" of="${DISK}" bs=512 seek=1 conv="${uboot_conv}" >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/H700_${SUBDEVICE}_u-boot-sunxi-with-spl.bin" ]; then
    # H700
    echo "image: writing u-boot-sunxi-with-spl.bin to $(basename "${DISK}")..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/H700_${SUBDEVICE}_u-boot-sunxi-with-spl.bin" of="${DISK}" bs=1K seek=8 conv=fsync,notrunc >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/rocknix-u-boot.img" ]; then
    # SM8750, SM8650 & SM8550
    echo "image: copying rocknix u-boot files..."
    mcopy -o "${RELEASE_DIR}/3rdparty/bootloader/rocknix-u-boot.img" ::
    mcopy -s -o "${RELEASE_DIR}/3rdparty/bootloader/device_trees" ::
  else
    echo "ERROR no u-boot file found for ${SUBDEVICE}"
    [ "${GAOOS_AB_BOOT}" != "yes" ] || show_error
  fi
}

mkimage_extlinux() {
  if [ "${GAOOS_AB_BOOT}" = "yes" ]; then
    # Standard boot tries extlinux before scripts. A/B images must enter boot.scr.
    local gaoos_fdt=""
    local gaoos_fdtdir="device_trees"
    local gaoos_fdt_type gaoos_fdt_path gaoos_overlays
    gaoos_fdt_type=$(get_fdt_type) || show_error
    gaoos_fdt_path=$(get_fdt) || show_error
    gaoos_overlays=$(get_fdt_overlays) || show_error
    if [ -z "${gaoos_fdt_path}" ]; then
      echo "ERROR: missing A/B device-tree configuration" >&2
      show_error
    fi
    case "${gaoos_fdt_type}" in
      FDT) gaoos_fdt="${gaoos_fdt_path}" ;;
      FDTDIR) gaoos_fdtdir="${gaoos_fdt_path}" ;;
      *) echo "ERROR: invalid A/B device-tree configuration" >&2; show_error ;;
    esac
    cat <<EOF > "${IMG_TMP}/gaoos_boot.env"
extra_cmdline=${EXTRA_CMDLINE}
gaoos_fdt=${gaoos_fdt}
gaoos_fdtdir=${gaoos_fdtdir}
gaoos_overlays=${gaoos_overlays}
EOF
    mcopy "${IMG_TMP}/gaoos_boot.env" ::/gaoos_boot.env >"${SAVE_ERROR}" 2>&1 || show_error
    return
  fi
  if [ -d "${RELEASE_DIR}/3rdparty/bootloader/extlinux" ]; then
    echo "image: copying custom extlinux.conf..."
    mcopy -s -o "${RELEASE_DIR}/3rdparty/bootloader/extlinux" ::
  else
    local fdt_type
    local fdt_overlays
    fdt_type=$(get_fdt_type)
    fdt_overlays=$(get_fdt_overlays)

    echo "image: set extlinux.conf to $fdt_type /$(get_fdt)..."
    mkdir -p "${IMG_TMP}/extlinux"

    cat << EOF > "${IMG_TMP}/extlinux/extlinux.conf"
LABEL ${DISTRO}
  LINUX /${KERNEL_NAME}
  ${fdt_type} /$(get_fdt)
  APPEND boot=LABEL=${DISTRO_BOOTLABEL} disk=LABEL=${DISTRO_DISKLABEL} ${EXTRA_CMDLINE}
EOF

    if [[ -n "${fdt_overlays}" ]]; then
      cat << EOF >> "${IMG_TMP}/extlinux/extlinux.conf"
  FDTOVERLAYS /overlays/${fdt_overlays}
EOF
    fi

    echo "image: copying extlinux.conf..."
    mcopy -s -o "${IMG_TMP}/extlinux" ::
  fi
}

mkimage_bootscr() {
  if [ -f "${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_boot.scr" ]; then
    echo "image: copying ${SUBDEVICE}_boot.scr..."
    mcopy "${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_boot.scr" ::/boot.scr
  else
    echo "cannot find ${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_boot.scr"
    exit 2
  fi
}

mkimage_dtb() {
  if [ "${GAOOS_AB_BOOT}" = "yes" ] && [ "${DEVICE}" = "RK3566" ] && [ "${SUBDEVICE}" = "Generic" ]; then
    if [ ! -s "${RELEASE_DIR}/3rdparty/bootloader/device_trees/rk3566-powkiddy-rgb30.dtb" ]; then
      echo "ERROR: RGB30 DTB missing from RK3566 Generic boot files" >&2
      show_error
    fi
  fi
  echo "image: copying device trees..."
  case "$DEVICE" in
    RK3326)
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/device_trees/"*.dtb ::
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/stock" ::
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/overlays" ::
      ;;
    SM8550|SM8650|SM8750|SM8250|SM6115|SM4450)
      mcopy -s -o "${RELEASE_DIR}/3rdparty/bootloader/boot" ::
      ;;
    S922X)
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/"*.dtb ::
      ;;
    *)
      mcopy -s "${RELEASE_DIR}/3rdparty/bootloader/device_trees" :: >"${SAVE_ERROR}" 2>&1 || show_error
      ;;
  esac

  if [ -d "${RELEASE_DIR}/3rdparty/bootloader/overlays" ]; then
    echo "image: copying device tree overlays..."
    mcopy -s "${RELEASE_DIR}/3rdparty/bootloader/overlays" ::
  fi
}

mkimage_gou_extras() {
  echo "image: copying res..."
  mcopy "${RELEASE_DIR}/3rdparty/bootloader/res" ::
}

mkimage_grub() {
  echo "image: copying grub files and dtb..."
  mcopy -s -o "${RELEASE_DIR}/3rdparty/bootloader/EFI" ::
}

mkimage_abl() {
  echo "image: copying ROCKNIX ABL..."
  mcopy "${RELEASE_DIR}/3rdparty/bootloader/rocknix_abl" ::
}

mkimage_all
